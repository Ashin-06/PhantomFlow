# .env.example
# Copy this to .env and fill in your values
# NEVER commit .env to git

# ─── Database ──────────────────────────────────────────────────────────────────
PG_USER=phantom
# docker/docker-compose.yml reads these: pass --env-file .env (see README)
PG_PASSWORD=change-me-local-dev
PG_DB=phantomflow
PG_HOST=localhost
# docker/docker-compose.yml publishes Postgres on 5433
PG_PORT=5433

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-local-dev
GRAFANA_ADMIN_PASSWORD=change-me-local-dev
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT ───────────────────────────────────────────────────────────────────────
# For dev: HS256 needs a random secret of 32+ characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256

# For production: switch to RS256
# JWT_ALGORITHM=RS256
# JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
# JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem

# ─── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC=network-flows

# ─── Secrets Provider ─────────────────────────────────────────────────────────
# Options: "env" (dev), "aws" (production), "vault" (production)
SECRETS_PROVIDER=env
# AWS_REGION=us-east-1
# VAULT_URL=https://vault.corp.local

# ─── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ─── Threat Intel APIs (optional) ─────────────────────────────────────────────
# ABUSEIPDB_API_KEY=your_key_here
# VIRUSTOTAL_API_KEY=your_key_here

# ─── ML ────────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MODEL_DIR=models/
TRAINING_MAX_ROWS=100000

# Explicit local development login; never enable on an exposed server.
ENV=production
ALLOW_DEV_LOGIN=false
# Set JWT_SECRET to a random value of at least 32 characters before signing in.
# For RS256, set JWT_PUBLIC_KEY and JWT_PRIVATE_KEY to PEM strings.
